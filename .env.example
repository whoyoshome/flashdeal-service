# Copy to .env for local runs outside Docker Compose. Never commit .env.

# HTTP server
HTTP_ADDR=:8080
# Profiling endpoints (pprof); keep this port private.
ADMIN_ADDR=:6060
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=15s
READINESS_TIMEOUT=2s
REQUEST_TIMEOUT=5s
RESERVATION_TTL=5m
IDEMPOTENCY_TTL=24h
DEAL_CACHE_TTL=2s

# Background workers
EXPIRE_EVERY=5s
EXPIRE_BATCH_SIZE=100
# Must exceed REQUEST_TIMEOUT by more than 5s.
RECONCILE_EVERY=30s
STOCK_SAMPLE_EVERY=5s

# PostgreSQL (local development credentials only)
POSTGRES_URL=postgres://flashdeal:flashdeal@localhost:5432/flashdeal?sslmode=disable
POSTGRES_MAX_CONNS=20
POSTGRES_MIN_CONNS=2
POSTGRES_CONNECT_TIMEOUT=5s
POSTGRES_STATEMENT_TIMEOUT=5s

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=50
REDIS_DIAL_TIMEOUT=500ms
REDIS_READ_TIMEOUT=500ms
REDIS_WRITE_TIMEOUT=500ms

# Tracing (OpenTelemetry, OTLP/HTTP). Empty endpoint disables it.
TRACING_OTLP_ENDPOINT=
TRACING_SAMPLE_RATIO=1
