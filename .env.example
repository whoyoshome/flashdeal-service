# Copy to .env for local runs outside Docker Compose. Never commit .env.

# Docker Compose reads .env too, including the JWT_* and TRACING_* values
# below (an empty TRACING_OTLP_ENDPOINT turns tracing off in the stack).
# When a local PostgreSQL or Redis already holds 5432 or 6379, a .env with
# only these two lines is enough for `make up`; point POSTGRES_URL /
# REDIS_ADDR at them for runs outside Compose. The containers keep talking
# on 5432 and 6379 inside the Compose network.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# HTTP server
HTTP_ADDR=:8080
# Profiling endpoints (pprof); keep this port private.
ADMIN_ADDR=:6060
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=15s
READINESS_TIMEOUT=2s
REQUEST_TIMEOUT=5s
RESERVATION_TTL=5m
IDEMPOTENCY_TTL=24h
DEAL_CACHE_TTL=2s

# Background workers
EXPIRE_EVERY=5s
EXPIRE_BATCH_SIZE=100
# Must exceed REQUEST_TIMEOUT by more than 5s.
RECONCILE_EVERY=30s
STOCK_SAMPLE_EVERY=5s

# PostgreSQL (local development credentials only)
POSTGRES_URL=postgres://flashdeal:flashdeal@localhost:5432/flashdeal?sslmode=disable
POSTGRES_MAX_CONNS=20
# Equal to the max so a sale's first burst does not open connections (ADR 0011)
POSTGRES_MIN_CONNS=20
POSTGRES_CONNECT_TIMEOUT=5s
POSTGRES_STATEMENT_TIMEOUT=5s

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=50
REDIS_DIAL_TIMEOUT=500ms
REDIS_READ_TIMEOUT=500ms
REDIS_WRITE_TIMEOUT=500ms

# Tracing (OpenTelemetry, OTLP/HTTP). Empty endpoint disables it.
TRACING_OTLP_ENDPOINT=
TRACING_SAMPLE_RATIO=1

# JWT (HS256). Same secret for the API and `make token` / k6 / e2e.
# At least 32 bytes. Replace before any non-local deployment.
JWT_SECRET=flashdeal-local-dev-secret-change-me!!
JWT_ISSUER=flashdeal
# Optional: RS256 via OIDC JWKS (when set, JWT_SECRET is unused for verify).
# JWT_JWKS_URL=https://idp.example/.well-known/jwks.json

# Per-subject token bucket on authenticated routes. RPS=0 disables it.
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100

# Rows a new deal's stock is split over in PostgreSQL (1-256), so concurrent
# reservations do not queue on one row lock. See ADR 0011.
STOCK_SHARDS=32

# Outbox relay: publishes order.confirmed events to a Redis Stream at least
# once (ADR 0012). Consumers drop duplicates by event_id.
OUTBOX_EVERY=1s
OUTBOX_BATCH_SIZE=100
OUTBOX_STREAM=flashdeal:events
OUTBOX_STREAM_MAXLEN=100000

# Sample event consumer (`make consume-events`). Uses REDIS_* above; bumps
# REDIS_READ_TIMEOUT past EVENTS_BLOCK automatically when needed.
# EVENTS_GROUP=flashdeal-demo
# EVENTS_CONSUMER=demo-1
# EVENTS_BATCH=100
# EVENTS_BLOCK=2s
# EVENTS_SEEN_TTL=168h
